---
import { getCollection } from 'astro:content';
import { marked } from 'marked';

const allProjects = await getCollection('projects');
allProjects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  const bTime = b.data.date ? new Date(b.data.date).getTime() : 0;
  const aTime = a.data.date ? new Date(a.data.date).getTime() : 0;
  return bTime - aTime;
});

const processed = allProjects.map(p => ({
  ...p,
  cleanGallery: (p.data.gallery || []).filter((s): s is string => s != null),
  descHtml: marked.parse(p.data.description || '') as string,
}));

const featured = processed.filter(p => p.data.featured);
const others   = processed.filter(p => !p.data.featured);
---

<section id="projects" style="background: var(--bg-subtle);">
  <div class="section-wrap reveal">
    <div class="section-header">
      <h2><span class="section-num">03.</span> Some Things I've Built</h2>
      <span class="section-rule" aria-hidden="true"></span>
    </div>

    <div class="featured-list">
      {featured.map((project, i) => (
        <div class={`featured-item ${i % 2 === 1 ? 'reversed' : ''}`}>

          <!-- Text column -->
          <div class="featured-text">
            <p class="feat-label">Featured Project</p>
            <h3 class="feat-title">{project.data.title}</h3>

            <div class="feat-desc-wrapper">
              <div class="feat-desc-box">
                <div class="feat-desc-body" set:html={project.descHtml} />
              </div>
              <button class="desc-toggle" aria-expanded="false">
                <span class="desc-toggle-label">Read more</span>
                <svg class="desc-toggle-icon" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>

            <ul class="feat-tags">
              {project.data.tags.map(tag => <li class="tag">{tag}</li>)}
            </ul>
            <div class="feat-links">
              {project.data.githubUrl && (
                <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="GitHub">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                </a>
              )}
              {project.data.externalUrl && (
                <a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="View project">
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                </a>
              )}
            </div>
          </div>

          <!-- Image column -->
          <div class="featured-images">
            <div class={`photo-stack-wrap ${project.cleanGallery.length > 0 ? 'has-stack' : ''}`}>
              {project.cleanGallery.length > 0 && (
                <>
                  <div class="stack-card stack-card-back" aria-hidden="true" />
                  <div class="stack-card stack-card-mid"  aria-hidden="true" />
                </>
              )}
              <div class="featured-main-image">
                {project.data.image
                  ? <img src={project.data.image} alt={project.data.title} data-lightbox="true" data-lightbox-group={project.id} />
                  : <div class="img-placeholder"><span>{project.data.title}</span></div>
                }
                {project.cleanGallery.length > 0 && (
                  <div class="photo-count" aria-hidden="true">
                    <svg width="12" height="12" fill="none" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.75">
                      <rect x="3" y="3" width="14" height="14" rx="2" />
                      <circle cx="7.5" cy="7.5" r="1.5" fill="currentColor" stroke="none"/>
                      <path stroke-linecap="round" d="M3 13l4-4 3 3 3-4 4 5"/>
                    </svg>
                    {project.cleanGallery.length + 1} photos
                  </div>
                )}
              </div>
              {project.cleanGallery.map((src, gi) => (
                <img
                  src={src}
                  alt={`${project.data.title} — photo ${gi + 2}`}
                  data-lightbox="true"
                  data-lightbox-group={project.id}
                  class="gallery-hidden"
                  aria-hidden="true"
                />
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

    {others.length > 0 && (
      <div class="others-section">
        <h3 class="others-heading">Other Noteworthy Projects</h3>
        <div class="others-grid reveal-group">
          {others.map(project => (
            <div class="other-card">
              <div class="other-top">
                <svg class="other-folder" width="34" height="34" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
                </svg>
                <div class="other-links">
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="GitHub">
                      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                    </a>
                  )}
                  {project.data.externalUrl && (
                    <a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer" class="icon-link" aria-label="View">
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </a>
                  )}
                </div>
              </div>
              <h4 class="other-title">{project.data.title}</h4>
              <p class="other-desc">{project.data.description}</p>
              <ul class="other-tags">
                {project.data.tags.map(tag => <li class="tag">{tag}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    )}

    {allProjects.length === 0 && (
      <p style="color: var(--text-faint); font-style: italic;">
        Add projects via the Keystatic admin at /keystatic
      </p>
    )}

  </div>
</section>

<style>
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: 6rem;
    margin-bottom: 5rem;
  }

  .featured-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 768px) {
    .featured-item {
      grid-template-columns: 42% 1fr;
      gap: 3.5rem;
      align-items: center;
    }
    .featured-item.reversed { grid-template-columns: 1fr 42%; }
    .featured-item.reversed .featured-images { order: -1; }
    .featured-item.reversed .featured-text  { text-align: right; }
    .featured-item.reversed .feat-tags  { justify-content: flex-end; }
    .featured-item.reversed .feat-links { justify-content: flex-end; }
    .featured-item.reversed .desc-toggle { margin-left: auto; }
  }

  /* ── Text column ── */
  .feat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .feat-title {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  /* Expandable description wrapper */
  .feat-desc-wrapper { margin-bottom: 1.25rem; }

  .feat-desc-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 2px 12px rgba(61, 43, 24, 0.06);
    position: relative;
    max-height: 8.5rem;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Fade-out gradient at bottom when collapsed */
  .feat-desc-box::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3rem;
    background: linear-gradient(to bottom, transparent, var(--bg-card));
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .feat-desc-box.expanded {
    max-height: 1200px;
  }
  .feat-desc-box.expanded::after {
    opacity: 0;
  }
  /* No constraint when content fits naturally */
  .feat-desc-box.fits {
    max-height: none;
    overflow: visible;
  }
  .feat-desc-box.fits::after { display: none; }

  .feat-desc-body {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
  .feat-desc-body :global(p) { margin: 0 0 0.6rem; }
  .feat-desc-body :global(p:last-child) { margin-bottom: 0; }
  .feat-desc-body :global(ul) {
    list-style: disc;
    padding-left: 1.35rem;
    margin: 0.25rem 0 0.6rem;
  }
  .feat-desc-body :global(li) { margin-bottom: 0.3rem; }
  .feat-desc-body :global(strong) { color: var(--text); font-weight: 600; }

  /* Read more / Read less toggle */
  .desc-toggle {
    display: none; /* shown by JS only when content overflows */
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    background: none;
    border: none;
    padding: 0.2rem 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .desc-toggle.visible { display: flex; }
  .desc-toggle:hover { opacity: 0.65; }

  .desc-toggle-icon {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }
  .desc-toggle.expanded .desc-toggle-icon {
    transform: rotate(180deg);
  }

  .feat-tags {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    list-style: none; margin: 0 0 1.25rem; padding: 0;
  }
  .feat-links { display: flex; gap: 0.75rem; }

  /* ── Image column ── */
  .featured-images { display: flex; flex-direction: column; }

  .photo-stack-wrap {
    position: relative;
    padding: 10px;
    margin: -10px;
  }

  .stack-card {
    position: absolute;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    top: 10px; left: 10px; right: 10px; bottom: 10px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stack-card-back {
    z-index: 0;
    transform: rotate(2.5deg) translate(4px, 5px);
    background: var(--bg-subtle);
  }
  .stack-card-mid {
    z-index: 1;
    transform: rotate(-1.5deg) translate(-3px, 4px);
  }
  .photo-stack-wrap.has-stack:hover .stack-card-back {
    transform: rotate(4deg) translate(7px, 9px);
  }
  .photo-stack-wrap.has-stack:hover .stack-card-mid {
    transform: rotate(-2.5deg) translate(-5px, 7px);
  }

  .featured-main-image {
    position: relative;
    z-index: 2;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--bg-card);
    border: 1px solid var(--border);
  }
  .featured-main-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .featured-main-image:hover img { transform: scale(1.02); }

  .photo-count {
    position: absolute;
    bottom: 0.65rem;
    right: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25em 0.6em;
    background: rgba(61, 43, 24, 0.65);
    backdrop-filter: blur(6px);
    color: rgba(245, 240, 230, 0.9);
    border-radius: 3px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    pointer-events: none;
  }

  .gallery-hidden { display: none; }

  .img-placeholder {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    border: 2px dashed var(--border);
  }
  .img-placeholder span {
    font-size: 0.9rem; color: var(--text-faint); font-weight: 500;
    text-align: center; padding: 1rem;
  }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.67rem;
    color: var(--text-muted);
  }
  .icon-link {
    color: var(--text-faint); display: flex;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .icon-link:hover { color: var(--accent); transform: translateY(-2px); }

  /* ── Other projects ── */
  .others-section { margin-top: 1rem; }
  .others-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem; letter-spacing: 0.08em;
    color: var(--text-faint); text-align: center; margin-bottom: 2.5rem;
  }
  .others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 340px));
    justify-content: center;
    gap: 1rem;
  }

  .other-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.75rem 1.5rem;
    display: flex; flex-direction: column; gap: 0.6rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .other-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .other-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .other-folder { color: var(--accent); }
  .other-links { display: flex; gap: 0.5rem; }
  .other-title { font-size: 1rem; font-weight: 700; color: var(--text); margin: 0; }
  .other-desc  { font-size: 0.85rem; line-height: 1.7; color: var(--text-muted); margin: 0; flex: 1; }
  .other-tags  { display: flex; flex-wrap: wrap; gap: 0.75rem; list-style: none; margin: 0; padding: 0; }

</style>

<script>
  document.querySelectorAll<HTMLElement>('.feat-desc-wrapper').forEach(wrapper => {
    const box   = wrapper.querySelector<HTMLElement>('.feat-desc-box')!;
    const btn   = wrapper.querySelector<HTMLButtonElement>('.desc-toggle')!;
    const label = btn.querySelector<HTMLElement>('.desc-toggle-label')!;

    // If content fits within the max-height, remove the constraint entirely
    if (box.scrollHeight <= box.clientHeight + 4) {
      box.classList.add('fits');
      return; // no button needed
    }

    // Content overflows — show the toggle button
    btn.classList.add('visible');

    btn.addEventListener('click', () => {
      const expanded = box.classList.toggle('expanded');
      btn.classList.toggle('expanded', expanded);
      btn.setAttribute('aria-expanded', String(expanded));
      label.textContent = expanded ? 'Read less' : 'Read more';
    });
  });
</script>
