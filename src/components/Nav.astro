---
import { getEntry } from 'astro:content';

const aboutEntry = await getEntry('about', 'about');
const resumePdf = aboutEntry?.data?.resumeUrl ?? null;

const links = [
  { href: '#about',      label: 'About',      num: '01', section: 'about'      },
  { href: '#experience', label: 'Experience', num: '02', section: 'experience' },
  { href: '#projects',   label: 'Projects',   num: '03', section: 'projects'   },
  { href: '#skills',     label: 'Skills',     num: '04', section: 'skills'     },
  { href: '#education',  label: 'Education',  num: '05', section: 'education'  },
  { href: '#contact',    label: 'Contact',    num: '06', section: 'contact'    },
];
---

<nav id="site-nav">
  <div id="scroll-progress"></div>
  <div class="nav-inner">
    <a href="#" class="nav-logo" aria-label="Home">
      <span class="logo-box">PZ</span>
    </a>

    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a href={link.href} data-section={link.section} class="nav-link">
            <span class="nav-num">{link.num}.</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      {resumePdf && (
        <a href={resumePdf} class="resume-link" target="_blank" rel="noopener noreferrer">Resume</a>
      )}

      <button id="mobile-btn" class="icon-btn mobile-only" aria-label="Open menu">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<div id="mobile-menu" aria-hidden="true">
  <button id="mobile-close" class="icon-btn close-btn" aria-label="Close menu">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <ul class="mobile-links">
    {links.map(link => (
      <li>
        <a href={link.href} class="mobile-link">
          <span class="mobile-num">{link.num}.</span>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  {resumePdf && (
    <a href={resumePdf} class="mobile-resume" target="_blank" rel="noopener noreferrer">Resume</a>
  )}
</div>

<style>
  #site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: var(--nav-bg);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  #scroll-progress {
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .nav-inner {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 4rem);
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav-logo { text-decoration: none; flex-shrink: 0; }
  .logo-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px; height: 38px;
    background: transparent;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .nav-logo:hover .logo-box {
    background: var(--accent);
    color: var(--nav-bg);
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0; padding: 0;
    gap: 0.1rem;
  }
  @media (min-width: 768px) {
    .nav-links { display: flex; align-items: center; }
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--nav-muted);
    text-decoration: none;
    border-radius: 4px;
    transition: color 0.2s ease;
  }
  .nav-num {
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    font-size: 0.72em;
  }
  .nav-link:hover,
  .nav-link.active { color: var(--nav-text); }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .resume-link {
    display: none;
    padding: 0.45rem 1rem;
    font-size: 0.78rem;
    font-weight: 400;
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .resume-link:hover {
    background: var(--accent);
    color: var(--nav-bg);
  }
  @media (min-width: 768px) { .resume-link { display: inline-flex; } }

  .icon-btn {
    display: flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem;
    border: none; border-radius: 6px;
    background: transparent;
    color: var(--nav-muted);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .icon-btn:hover { background: rgba(255,255,255,0.07); color: var(--nav-text); }

  .mobile-only { display: flex; }
  @media (min-width: 768px) { .mobile-only { display: none; } }

  #mobile-menu {
    position: fixed; inset: 0;
    z-index: 100;
    background: var(--nav-bg);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
  }
  #mobile-menu.open { display: flex; }

  .close-btn {
    position: absolute;
    top: 1.5rem; right: 1.5rem;
    width: 2.5rem; height: 2.5rem;
    color: var(--nav-muted);
  }

  .mobile-links {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column;
    align-items: center; gap: 0.25rem;
    margin-bottom: 2.5rem;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: clamp(1.4rem, 5vw, 1.9rem);
    font-weight: 600;
    color: var(--nav-muted);
    text-decoration: none;
    padding: 0.5rem 1.25rem;
    transition: color 0.2s ease;
  }
  .mobile-num {
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    font-size: 0.6em;
  }
  .mobile-link:hover { color: var(--nav-text); }

  .mobile-resume {
    padding: 0.65rem 1.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .mobile-resume:hover {
    background: var(--accent);
    color: var(--nav-bg);
  }
</style>

<script>
  const progress = document.getElementById('scroll-progress')!;

  function onScroll() {
    const scrolled = window.scrollY;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${total > 0 ? scrolled / total : 0})`;
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const navLinks = document.querySelectorAll<HTMLElement>('.nav-link[data-section]');
  const sections = document.querySelectorAll('section[id]');

  const spy = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          link.classList.toggle('active', link.dataset.section === entry.target.id);
        });
      }
    });
  }, { rootMargin: '-35% 0px -65% 0px' });

  sections.forEach(s => spy.observe(s));

  const menu    = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('mobile-btn')!;
  const closeBtn = document.getElementById('mobile-close')!;
  const open  = () => { menu.classList.add('open');    menu.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; };
  const close = () => { menu.classList.remove('open'); menu.setAttribute('aria-hidden','true');  document.body.style.overflow=''; };
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
</script>
