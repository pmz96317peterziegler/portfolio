---
import { getEntry } from 'astro:content';

const site = (await getEntry('site', 'site'))?.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">
      Designed &amp; Built by {site?.name}
    </p>
    <p class="footer-year">© {year}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nav-bg);
    padding-block: 2rem;
  }
  .footer-inner {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(1.5rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer-copy {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--nav-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }
  .footer-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--nav-muted);
    margin: 0;
  }
</style>
